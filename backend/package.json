{
  "name": "email-scheduler-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Email job scheduler API + BullMQ worker (ReachInbox assignment)",
  "scripts": {
    "dev": "concurrently -n api,worker -c cyan,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "concurrently -n api,worker -c cyan,magenta \"npm:start:api\" \"npm:start:worker\"",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:senders": "tsx src/scripts/seedSenders.ts",
    "loadtest": "tsx src/scripts/loadTest.ts",
    "setup": "prisma migrate deploy && prisma generate && npm run seed:senders"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.1.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
