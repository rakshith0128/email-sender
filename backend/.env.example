# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Replace YOUR_PASSWORD with the password you set during the PostgreSQL install.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/email_scheduler

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Same Client ID you put in frontend/.env.local — used to verify Google ID tokens.
GOOGLE_CLIENT_ID=
# Secret used to sign this backend's own session JWTs. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Set to true to bypass auth entirely (handy for Postman before OAuth is wired up).
AUTH_DISABLED=false

# ─── Worker concurrency ──────────────────────────────────────────────────────
# How many jobs a single worker process handles in parallel.
WORKER_CONCURRENCY=5

# ─── Minimum delay between individual sends (provider throttling mimic) ──────
# BullMQ worker limiter: at most GLOBAL_LIMITER_MAX jobs per MIN_SEND_INTERVAL_MS,
# enforced in Redis so it holds across every worker process/instance.
# Defaults => 1 email per 2000ms => a hard 2 second minimum between sends.
# Raise GLOBAL_LIMITER_MAX to let WORKER_CONCURRENCY actually parallelize.
MIN_SEND_INTERVAL_MS=2000
GLOBAL_LIMITER_MAX=1

# On top of the BullMQ limiter (a fixed-window rate cap), a Redis compare-and-set
# gate enforces a hard minimum gap between sends. Scope:
#   global -> one send per MIN_SEND_INTERVAL_MS across the whole system.
#             Strictest reading of the requirement; makes the system serial, so
#             WORKER_CONCURRENCY cannot do useful work.
#   sender -> each sender is throttled independently, mimicking real per-provider
#             throttling. N senders then run in parallel and concurrency pays off.
SEND_INTERVAL_SCOPE=global

# ─── Hourly rate limit (per sender) ──────────────────────────────────────────
# Default cap applied to each sender created by the seed script.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Spacing used to preserve FIFO order when a batch overflows into the next hour.
ORDER_STEP_MS=50

# ─── Reliability ─────────────────────────────────────────────────────────────
# Self-rescheduling delayed sweep that re-arms missing jobs from Postgres.
# This is NOT a cron — it is a BullMQ delayed job that re-enqueues itself.
RECONCILE_INTERVAL_MS=60000
# A job stuck in `processing` longer than this is considered crashed and reclaimed.
STALE_LOCK_MS=120000
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# ─── Seeding ─────────────────────────────────────────────────────────────────
# Number of Ethereal test sender accounts to create with `npm run seed:senders`.
ETHEREAL_SENDER_COUNT=3
