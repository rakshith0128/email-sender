# ─── Google OAuth ────────────────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random secret used to encrypt the Auth.js session cookie.
# Generate one with:  npx auth secret     (or any long random string)
AUTH_SECRET=

# Auth.js needs to know its own origin.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ─── Backend ─────────────────────────────────────────────────────────────────
# Used by the browser, so it must be NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Used server-side by the Auth.js signIn callback to exchange the Google
# id_token for a backend session JWT. Same value, no NEXT_PUBLIC_ prefix.
API_URL=http://localhost:4000
